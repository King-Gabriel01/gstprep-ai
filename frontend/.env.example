# URL of your deployed backend API, including /api
# Local dev: leave unset, Vite proxy handles it (see vite.config.js)
# Production: set to e.g. https://gstprep-ai-backend.onrender.com/api
VITE_API_URL=

# Google Sign-In client ID (same project as backend's GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Cloudinary (profile picture uploads) - from your Cloudinary dashboard
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
