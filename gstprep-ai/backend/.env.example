# Server
PORT=5000
NODE_ENV=development

# Database
# Local:  mongodb://127.0.0.1:27017/gstprep
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gstprep
MONGO_URI=mongodb://127.0.0.1:27017/gstprep

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Anthropic (Claude) API - get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6

# Frontend origin (for CORS) - set to your deployed frontend URL in production
CLIENT_URL=http://localhost:5173

# File uploads
MAX_UPLOAD_MB=15
