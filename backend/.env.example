# Server
PORT=5000
NODE_ENV=development

# Database
# Local:  mongodb://127.0.0.1:27017/gstprep
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gstprep
MONGO_URI=mongodb://127.0.0.1:27017/gstprep

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# xAI (Grok) API - get a key from https://console.x.ai
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxx
GROK_MODEL=grok-2-latest
XAI_BASE_URL=https://api.x.ai/v1

# Frontend origin (for CORS) - set to your deployed frontend URL in production
CLIENT_URL=http://localhost:5173

# File uploads
MAX_UPLOAD_MB=15
