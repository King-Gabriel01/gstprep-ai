# Server
PORT=5000
NODE_ENV=development

# Database
# Local:  mongodb://127.0.0.1:27017/gstprep
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gstprep
MONGO_URI=mongodb://127.0.0.1:27017/gstprep

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Google Gemini API (free tier) - get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Frontend origin (for CORS) - set to your deployed frontend URL in production
CLIENT_URL=http://localhost:5173

# Google Sign-In - get from https://console.cloud.google.com (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx

# Resend (email verification) - get an API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=GSTPrep AI <onboarding@resend.dev>

# File uploads
MAX_UPLOAD_MB=15
